<script>
function ft() {
  const t = document.getElementById('fType').value;
  const v = document.getElementById('fVar').value;
  const s = document.getElementById('fSeg').value;
  const rows = document.querySelectorAll('#tbl tbody tr');
  let vis = 0;
  rows.forEach(r => {
