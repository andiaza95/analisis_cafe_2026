    r.classList.toggle('hidden', !ok);
    if(ok) vis++;
  });
  document.getElementById('rinfo').textContent = vis===rows.length
    ? `Mostrando todos los productos (${rows.length})`
    : `Mostrando ${vis} de ${rows.length} productos`;
}
